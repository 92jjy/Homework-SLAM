<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ========== 激光雷达参数 ========== -->
  <xacro:property name="lidar_radius" value="0.05"/>
  <xacro:property name="lidar_height" value="0.06"/>
  <xacro:property name="lidar_mass" value="0.05"/>

  <!-- ========== 激光雷达材质（定义在插件中） ========== -->
  <material name="lidar_material">
    <color rgba="0.1 0.1 0.1 1"/>
  </material>

  <!-- ========== 激光雷达宏 ========== -->
  <xacro:macro name="add_lidar" params="prefix 
                        x:=0 y:=0 z:=0.1
                        min_range:=0.1 max_range:=8.0
                        angle_min:=-3.14159 angle_max:=3.14159
                        samples:=360">

    <!-- 激光雷达链接 -->
    <link name="${prefix}_lidar_link">
      <visual>
        <geometry>
          <cylinder radius="${lidar_radius}" length="${lidar_height}"/>
        </geometry>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <material name="lidar_material"/>
      </visual>
      <collision>
        <geometry>
          <cylinder radius="${lidar_radius}" length="${lidar_height}"/>
        </geometry>
        <origin xyz="0 0 0" rpy="0 0 0"/>
      </collision>
      <inertial>
        <mass value="${lidar_mass}"/>
        <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
      </inertial>
    </link>

    <!-- 激光雷达关节：父链接统一使用 base_link -->
    <joint name="${prefix}_lidar_joint" type="fixed">
      <parent link="base_link"/>
      <child link="${prefix}_lidar_link"/>
      <origin xyz="${x} ${y} ${z}" rpy="0 0 0"/>
    </joint>

    <!-- Gazebo 激光雷达插件 -->
    <gazebo reference="${prefix}_lidar_link">
      <material>Gazebo/Black</material>
      <sensor name="${prefix}_lidar_sensor" type="ray">
        <pose>0 0 0 0 0 0</pose>
        <visualize>true</visualize>
        <update_rate>10</update_rate>
        <ray>
          <scan>
            <horizontal>
              <samples>${samples}</samples>
              <resolution>1</resolution>
              <min_angle>${angle_min}</min_angle>
              <max_angle>${angle_max}</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>${min_range}</min>
            <max>${max_range}</max>
            <resolution>0.01</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.01</stddev>
          </noise>
        </ray>
        <plugin name="${prefix}_lidar_controller" filename="libgazebo_ros_ray_sensor.so">
          <ros>
            <namespace>/</namespace>
            <remapping>~/out:=${prefix}_scan</remapping>
          </ros>
          <output_type>sensor_msgs/LaserScan</output_type>
          <frame_name>${prefix}_lidar_link</frame_name>
          <min_range>${min_range}</min_range>
          <max_range>${max_range}</max_range>
        </plugin>
      </sensor>
    </gazebo>

  </xacro:macro>

</robot>
